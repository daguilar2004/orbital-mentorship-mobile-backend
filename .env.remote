# Remote Device Setup
# Use this file when connecting from another device
# Replace YOUR_HOST_IP with the machine running this server

# Get your machine's IP: 
# - Linux/Mac: ifconfig | grep "inet " (look for local network IP like 192.168.x.x)
# - Windows: ipconfig (look for IPv4 Address)

PORT=4000
MONGODB_URI=mongodb://YOUR_HOST_IP:27017/orbital-mentorship-dev
